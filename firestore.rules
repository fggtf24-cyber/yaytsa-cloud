rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Только вход через Google: по почте с паролем можно зарегистрировать чужой адрес.
    function isGoogle() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return isGoogle()
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
    match /apps/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /projects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Комментарии: пишет вошедший пользователь, удаляет автор или админ.
    // Менять можно только likedBy и только свой лайк: ровно один свой uid туда или обратно.
    function togglesOwnLike() {
      let before = resource.data.likedBy.toSet();
      let after = request.resource.data.likedBy.toSet();
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
        && request.resource.data.likedBy.size() == after.size()
        && after.difference(before).union(before.difference(after)) == [request.auth.uid].toSet();
    }
    // Смена имени или фото в профиле обновляет свои комментарии, менять в них что-то ещё нельзя.
    function changesOwnProfile() {
      return resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photo'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 100000;
    }
    match /comments/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['appId', 'uid', 'name', 'photo', 'text', 'image', 'createdAt', 'likedBy', 'parentId'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.appId is string
        && request.resource.data.appId.size() <= 100
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 100000
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && (request.resource.data.text.size() > 0 || 'image' in request.resource.data)
        && str(request.resource.data.get('image', ''), 0, 800000)
        && request.resource.data.createdAt == request.time
        // Комментарий рождается со своим лайком, как на Reddit. Пустой список принимаем от вкладок со старым кодом.
        && (request.resource.data.likedBy == [] || request.resource.data.likedBy == [request.auth.uid])
        && (!('parentId' in request.resource.data)
          || (request.resource.data.parentId is string && request.resource.data.parentId.size() <= 100));
      allow update: if request.auth != null && (togglesOwnLike() || changesOwnProfile());
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
    }
    // Уведомления: читает и отмечает прочитанным только получатель. Создать можно только про настоящий комментарий
    // этого получателя. У лайка id постоянный и обновлять его чужому нельзя, поэтому повторного уведомления не будет.
    function isDmPartner(messageId, to) {
      let m = get(/databases/$(database)/documents/messages/$(messageId)).data;
      return (m.to == to && m.from == request.auth.uid) || (m.from == to && m.to == request.auth.uid);
    }
    // Ответ в ветке поста: commentId — мой новый комментарий, appId — пост. Получатель — автор поста или того, кому отвечаю.
    function isThreadReply(n) {
      let c = get(/databases/$(database)/documents/tcomments/$(n.commentId)).data;
      return c.uid == request.auth.uid && c.postId == n.appId
        && (c.parentId == ''
          ? get(/databases/$(database)/documents/posts/$(n.appId)).data.uid == n.to
          : get(/databases/$(database)/documents/tcomments/$(c.parentId)).data.uid == n.to);
    }
    function isRealTarget(n) {
      return (n.type == 'dm' && isDmPartner(n.commentId, n.to))
        || (n.type == 'follow' && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + n.to)))
        || (n.type == 'treply' && isThreadReply(n))
        || (n.type == 'mod' && isAdmin())
        || (n.type in ['reply', 'like'] && get(/databases/$(database)/documents/comments/$(n.commentId)).data.uid == n.to);
    }
    match /notifications/{id} {
      allow read: if request.auth != null && resource.data.to == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['to', 'from', 'fromName', 'type', 'appId', 'commentId', 'text', 'createdAt', 'read'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && request.resource.data.type in ['reply', 'like', 'dm', 'follow', 'treply', 'mod']
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 80
        && request.resource.data.appId is string
        && request.resource.data.appId.size() <= 100
        && request.resource.data.commentId is string
        && request.resource.data.commentId.size() <= 100
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 120
        && request.resource.data.createdAt == request.time
        && request.resource.data.read == false
        && isRealTarget(request.resource.data)
        && (request.resource.data.type != 'like'
          || id == 'like_' + request.resource.data.commentId + '_' + request.auth.uid)
        && (request.resource.data.type != 'follow'
          || id == 'follow_' + request.auth.uid + '_' + request.resource.data.to);
      allow update: if request.auth != null
        && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
    }
    // Публичные имена админов для поля «Автор». Каждый пишет только себя.
    match /authors/{uid} {
      allow read: if true;
      allow write: if isAdmin() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
    }
    // Личка: баг или идею получает только автор программы. Видят оба участника, удаляет автор.
    match /messages/{id} {
      allow read: if request.auth != null
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow delete: if request.auth != null && resource.data.to == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['to', 'from', 'fromName', 'fromEmail', 'type', 'appId', 'appName', 'text', 'createdAt', 'read'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.type in ['bug', 'idea']
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 80
        && request.resource.data.fromEmail == request.auth.token.email
        && request.resource.data.appId is string
        && request.resource.data.appName is string
        && request.resource.data.appName.size() <= 100
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time
        && request.resource.data.read == false
        && get(/databases/$(database)/documents/apps/$(request.resource.data.appId)).data.authorUid == request.resource.data.to;
      allow update: if request.auth != null
        && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
    }
    // Ответы в личке: пишут и читают только два участника сообщения.
    function isMessageMember(messageId, participants) {
      let m = get(/databases/$(database)/documents/messages/$(messageId)).data;
      return request.auth.uid in [m.to, m.from] && participants == [m.to, m.from];
    }
    match /replies/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['messageId', 'participants', 'from', 'name', 'text', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.messageId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time
        && isMessageMember(request.resource.data.messageId, request.resource.data.participants);
    }
    // Счётчики: visits_<день> и dl_<программа>_<день>. Любой может прибавить ровно 1, читают только админы.
    match /stats/{id} {
      allow read: if isAdmin();
      allow create: if id.matches('^(visits|dl_[A-Za-z0-9-]+)_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1;
    }
    // Профиль: имя и аватарка (сжатая картинка строкой). Видит и меняет только владелец.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'photo'])
        && request.resource.data.get('name', '').size() <= 80
        && request.resource.data.get('photo', '').size() <= 100000;
    }
    /* ---------- Соцчасть: профили, посты, ветки, голоса, подписки, чаты ---------- */

    function signedIn() { return request.auth != null; }
    function hasProfile() { return exists(/databases/$(database)/documents/profiles/$(request.auth.uid)); }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }

    // Публичный профиль. username должен быть закреплён за этим же uid в usernames — так имена не повторяются.
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'name', 'photo', 'bio', 'banner', 'links', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{1,20}$')
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid
        && str(request.resource.data.get('name', ''), 0, 80)
        && str(request.resource.data.get('photo', ''), 0, 100000)
        && str(request.resource.data.get('bio', ''), 0, 300)
        && str(request.resource.data.get('banner', ''), 0, 200000)
        && request.resource.data.get('links', {}) is map
        && request.resource.data.get('links', {}).size() <= 10
        && (resource == null
          ? request.resource.data.createdAt == request.time
          : request.resource.data.createdAt == resource.data.createdAt);
    }
    // @имя -> uid. Занять можно только свободное имя, освободить — только своё и только сменив его в профиле.
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn() && name.matches('^[a-z0-9_]{1,20}$') && name != 'everyone'
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username == name;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username != name;
    }
    // Когда человек был на сайте. Время ставит сервер, подделать его нельзя.
    match /presence/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
    }
    // Подписка: id = <кто>_<на кого>. Взаимная подписка отдельно не хранится.
    match /follows/{id} {
      allow read: if true;
      allow create: if signedIn() && hasProfile()
        && request.resource.data.keys().hasOnly(['from', 'to', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.to));
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }

    // На сколько сдвинулся мой голос за пост (p) или комментарий (c) в этой же пачке записей.
    function voteDelta(kind, target) {
      let vote = /databases/$(database)/documents/votes/$(kind + '_' + target + '_' + request.auth.uid);
      return getAfter(vote).data.v - (exists(vote) ? get(vote).data.v : 0);
    }
    function scoreFollows(kind, target, before, after) {
      return (kind == 'p'
          && getAfter(/databases/$(database)/documents/posts/$(target)).data.score
            == get(/databases/$(database)/documents/posts/$(target)).data.score + after - before)
        || (kind == 'c'
          && getAfter(/databases/$(database)/documents/tcomments/$(target)).data.score
            == get(/databases/$(database)/documents/tcomments/$(target)).data.score + after - before);
    }
    // Свой первый голос: пост или комментарий создаётся в этой же пачке записей со счётом 1.
    function isNewOwnItem(kind, target) {
      let path = kind == 'p' ? /databases/$(database)/documents/posts/$(target) : /databases/$(database)/documents/tcomments/$(target);
      return !exists(path) && getAfter(path).data.uid == request.auth.uid && getAfter(path).data.score == 1;
    }
    function hasOwnVote(kind, target) {
      return getAfter(/databases/$(database)/documents/votes/$(kind + '_' + target + '_' + request.auth.uid)).data.v == 1;
    }
    // Голос: один на человека, -1, 0 или 1. Меняется только вместе со счётом поста или комментария.
    match /votes/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'kind', 'target', 'v'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['p', 'c']
        && request.resource.data.target is string
        && request.resource.data.v in [-1, 0, 1]
        && id == request.resource.data.kind + '_' + request.resource.data.target + '_' + request.auth.uid
        && ((resource == null && request.resource.data.v == 1
            && isNewOwnItem(request.resource.data.kind, request.resource.data.target))
          || scoreFollows(request.resource.data.kind, request.resource.data.target,
            resource == null ? 0 : resource.data.v, request.resource.data.v));
    }

    // Пост на странице автора. appId — необязательная привязка к программе.
    match /posts/{id} {
      allow read: if true;
      allow create: if signedIn() && hasProfile()
        && request.resource.data.keys().hasOnly(['uid', 'title', 'body', 'appId', 'score', 'commentCount', 'createdAt', 'imageRatio'])
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.title, 1, 300)
        && str(request.resource.data.body, 0, 10000)
        && str(request.resource.data.appId, 0, 100)
        && (request.resource.data.score == 0 || (request.resource.data.score == 1 && hasOwnVote('p', id)))
        && request.resource.data.get('imageRatio', 1) is number
        && (!('imageRatio' in request.resource.data)
          || getAfter(/databases/$(database)/documents/postimages/$(id)).data.uid == request.auth.uid)
        && request.resource.data.commentCount == 0
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && (
        (resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'editedAt'])
          && str(request.resource.data.body, 0, 10000)
          && request.resource.data.editedAt == request.time)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score'])
          && request.resource.data.score == resource.data.score + voteDelta('p', id))
        // ponytail: +1 к счётчику может прислать любой вошедший; честно его считал бы только сервер
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
          && request.resource.data.commentCount == resource.data.commentCount + 1));
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    // Картинка поста лежит отдельно, чтобы лента не качала все картинки разом. id такой же, как у поста.
    match /postimages/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'image'])
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.image, 1, 800000)
        && getAfter(/databases/$(database)/documents/posts/$(id)).data.uid == request.auth.uid;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin()
        || !existsAfter(/databases/$(database)/documents/posts/$(id)));
    }
    // Комментарии в ветке поста. parentId = '' — ответ на сам пост. Удаление стирает текст, ветка остаётся.
    match /tcomments/{id} {
      allow read: if true;
      allow create: if signedIn() && hasProfile()
        && request.resource.data.keys().hasOnly(['postId', 'parentId', 'uid', 'body', 'image', 'sticker', 'score', 'deleted', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.parentId is string
        && (request.resource.data.parentId == ''
          || get(/databases/$(database)/documents/tcomments/$(request.resource.data.parentId)).data.postId == request.resource.data.postId)
        && str(request.resource.data.body, 0, 5000)
        && (request.resource.data.body.size() > 0 || 'image' in request.resource.data || 'sticker' in request.resource.data)
        && str(request.resource.data.get('sticker', ''), 0, 20)
        && str(request.resource.data.get('image', ''), 0, 800000)
        && (request.resource.data.score == 0 || (request.resource.data.score == 1 && hasOwnVote('c', id)))
        && request.resource.data.deleted == false
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.commentCount
          == get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.commentCount + 1;
      allow update: if signedIn() && (
        (resource.data.uid == request.auth.uid && resource.data.deleted == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'image', 'sticker', 'deleted', 'editedAt'])
          && !('image' in request.resource.data && request.resource.data.image != resource.data.get('image', ''))
          && !('sticker' in request.resource.data && request.resource.data.sticker != resource.data.get('sticker', ''))
          && str(request.resource.data.body, 0, 5000)
          && request.resource.data.deleted is bool
          && request.resource.data.editedAt == request.time)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score'])
          && request.resource.data.score == resource.data.score + voteDelta('c', id))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'image', 'sticker', 'deleted'])
          && !('image' in request.resource.data)
          && !('sticker' in request.resource.data)
          && request.resource.data.body == '' && request.resource.data.deleted == true));
      // Совсем стереть можно свой комментарий, любой чужой админу и любой, у которого пост уже удалён.
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin()
        || !existsAfter(/databases/$(database)/documents/posts/$(resource.data.postId)));
    }

    // Пост с @everyone: один документ на всех, браузер каждого сам показывает его в колокольчике.
    match /broadcasts/{id} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'title', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && str(request.resource.data.fromName, 0, 80)
        && str(request.resource.data.title, 0, 120)
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/posts/$(id)).data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Кто зарегистрировался. Браузер пишет почту только о себе, читают только админы.
    match /accounts/{uid} {
      allow read: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'provider', 'created', 'lastSeen'])
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.provider == request.auth.token.firebase.sign_in_provider
        && str(request.resource.data.created, 0, 40)
        && request.resource.data.lastSeen == request.time;
    }

    // Заявки на программу. Без селфи и согласия на его показ заявку не принять.
    // Селфи лежит отдельно: до одобрения его видят автор и админы, после одобрения все на странице программы.
    // Одобряет админ: его браузер сам переносит заявку в apps, поэтому новых прав на каталог здесь нет.
    match /submissions/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && hasProfile()
        && request.resource.data.keys().hasOnly(['uid', 'status', 'createdAt', 'icon', 'name', 'desc', 'file', 'size', 'features', 'needs', 'site', 'repo', 'demo', 'coauthors', 'selfiePublic'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.selfiePublic == true
        && request.resource.data.createdAt == request.time
        && str(request.resource.data.name, 1, 100)
        && str(request.resource.data.desc, 1, 1000)
        && str(request.resource.data.file, 9, 500)
        && request.resource.data.file.matches('^https://.+')
        && str(request.resource.data.get('icon', ''), 0, 200000)
        && str(request.resource.data.get('size', ''), 0, 40)
        && str(request.resource.data.get('site', ''), 0, 500)
        && str(request.resource.data.get('repo', ''), 0, 500)
        && str(request.resource.data.get('demo', ''), 0, 500)
        && request.resource.data.get('features', []) is list
        && request.resource.data.get('features', []).size() <= 30
        && request.resource.data.get('needs', []) is list
        && request.resource.data.get('needs', []).size() <= 30
        && request.resource.data.get('coauthors', []) is list
        && request.resource.data.get('coauthors', []).size() <= 10
        && getAfter(/databases/$(database)/documents/selfies/$(id)).data.uid == request.auth.uid;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reason'])
        && request.resource.data.status in ['approved', 'rejected']
        && str(request.resource.data.get('reason', ''), 0, 300);
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    match /selfies/{id} {
      allow read: if (signedIn() && (resource.data.uid == request.auth.uid || isAdmin()))
        || get(/databases/$(database)/documents/submissions/$(id)).data.status == 'approved';
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'image'])
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.image, 1, 300000)
        && getAfter(/databases/$(database)/documents/submissions/$(id)).data.uid == request.auth.uid;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Личный чат двоих: id = <меньший uid>_<больший uid>. Группа: случайный id и group == true.
    // Сообщения лежат внутри и видны только участникам.
    function isDirectChat(d, id) {
      return !('group' in d) && d.members.size() == 2
        && d.members[0] < d.members[1]
        && id == d.members[0] + '_' + d.members[1]
        && exists(/databases/$(database)/documents/profiles/$(d.members[0]))
        && exists(/databases/$(database)/documents/profiles/$(d.members[1]));
    }
    function isNewGroup(d) {
      return d.get('group', false) == true && d.owner == request.auth.uid
        && str(d.name, 1, 60) && d.members.size() >= 2 && d.members.size() <= 50;
    }
    match /chats/{id} {
      allow get: if signedIn()
        && (resource == null ? request.auth.uid in id.split('_') : request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'lastText', 'lastFrom', 'lastAt', 'seen', 'group', 'name', 'owner'])
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && (isDirectChat(request.resource.data, id) || isNewGroup(request.resource.data))
        && request.resource.data.lastFrom == request.auth.uid
        && str(request.resource.data.lastText, 0, 200)
        && request.resource.data.lastAt == request.time
        && request.resource.data.seen is map;
      allow update: if signedIn() && request.auth.uid in resource.data.members && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText', 'lastFrom', 'lastAt', 'seen'])
          && str(request.resource.data.lastText, 0, 200)
          && (!('lastFrom' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.lastFrom == request.auth.uid)
          && (!('lastAt' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.lastAt == request.time)
          && request.resource.data.seen is map)
        // Создатель группы меняет участников, название и фото, любой участник может выйти.
        || (resource.data.get('group', false) == true && resource.data.owner == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'name', 'photo'])
          && request.resource.data.members is list
          && request.resource.data.members.size() <= 50
          && str(request.resource.data.name, 1, 60)
          && str(request.resource.data.get('photo', ''), 0, 100000))
        || (resource.data.get('group', false) == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])));
      // Группу удаляет только её создатель: сначала сообщения, потом сам чат.
      allow delete: if signedIn() && resource.data.get('group', false) == true && resource.data.owner == request.auth.uid;
      match /msgs/{mid} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(id)).data.members;
        allow delete: if signedIn()
          && get(/databases/$(database)/documents/chats/$(id)).data.get('owner', '') == request.auth.uid;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['from', 'text', 'sticker', 'createdAt'])
          && request.resource.data.from == request.auth.uid
          && str(request.resource.data.text, 0, 2000)
          && (request.resource.data.text.size() > 0 || 'sticker' in request.resource.data)
          && str(request.resource.data.get('sticker', ''), 0, 20)
          && request.resource.data.createdAt == request.time
          && request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(id)).data.members;
      }
    }

    // Админ = документ admins/<почта>. Список читать нельзя, только проверить себя. Меняется из консоли.
    match /admins/{email} {
      allow get: if isGoogle() && request.auth.token.email == email;
    }
  }
}
