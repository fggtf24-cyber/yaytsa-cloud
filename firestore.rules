rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Только вход через Google: по почте с паролем можно зарегистрировать чужой адрес.
    function isGoogle() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return isGoogle()
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
    match /apps/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /projects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Комментарии: пишет вошедший пользователь, удаляет автор или админ.
    // Менять можно только likedBy и только свой лайк: ровно один свой uid туда или обратно.
    function togglesOwnLike() {
      let before = resource.data.likedBy.toSet();
      let after = request.resource.data.likedBy.toSet();
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
        && request.resource.data.likedBy.size() == after.size()
        && after.difference(before).union(before.difference(after)) == [request.auth.uid].toSet();
    }
    // Смена имени или фото в профиле обновляет свои комментарии, менять в них что-то ещё нельзя.
    function changesOwnProfile() {
      return resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photo'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 100000;
    }
    match /comments/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['appId', 'uid', 'name', 'photo', 'text', 'createdAt', 'likedBy', 'parentId'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.appId is string
        && request.resource.data.appId.size() <= 100
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 100000
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time
        && request.resource.data.likedBy == []
        && (!('parentId' in request.resource.data)
          || (request.resource.data.parentId is string && request.resource.data.parentId.size() <= 100));
      allow update: if request.auth != null && (togglesOwnLike() || changesOwnProfile());
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
    }
    // Уведомления: читает и отмечает прочитанным только получатель. Создать можно только про настоящий комментарий
    // этого получателя. У лайка id постоянный и обновлять его чужому нельзя, поэтому повторного уведомления не будет.
    function isDmPartner(messageId, to) {
      let m = get(/databases/$(database)/documents/messages/$(messageId)).data;
      return (m.to == to && m.from == request.auth.uid) || (m.from == to && m.to == request.auth.uid);
    }
    function isRealTarget(n) {
      return n.type == 'dm'
        ? isDmPartner(n.commentId, n.to)
        : get(/databases/$(database)/documents/comments/$(n.commentId)).data.uid == n.to;
    }
    match /notifications/{id} {
      allow read: if request.auth != null && resource.data.to == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['to', 'from', 'fromName', 'type', 'appId', 'commentId', 'text', 'createdAt', 'read'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && request.resource.data.type in ['reply', 'like', 'dm']
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 80
        && request.resource.data.appId is string
        && request.resource.data.appId.size() <= 100
        && request.resource.data.commentId is string
        && request.resource.data.commentId.size() <= 100
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 120
        && request.resource.data.createdAt == request.time
        && request.resource.data.read == false
        && isRealTarget(request.resource.data)
        && (request.resource.data.type != 'like'
          || id == 'like_' + request.resource.data.commentId + '_' + request.auth.uid);
      allow update: if request.auth != null
        && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
    }
    // Публичные имена админов для поля «Автор». Каждый пишет только себя.
    match /authors/{uid} {
      allow read: if true;
      allow write: if isAdmin() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
    }
    // Личка: баг или идею получает только автор программы. Видят оба участника, удаляет автор.
    match /messages/{id} {
      allow read: if request.auth != null
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow delete: if request.auth != null && resource.data.to == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['to', 'from', 'fromName', 'fromEmail', 'type', 'appId', 'appName', 'text', 'createdAt', 'read'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.type in ['bug', 'idea']
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 80
        && request.resource.data.fromEmail == request.auth.token.email
        && request.resource.data.appId is string
        && request.resource.data.appName is string
        && request.resource.data.appName.size() <= 100
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time
        && request.resource.data.read == false
        && get(/databases/$(database)/documents/apps/$(request.resource.data.appId)).data.authorUid == request.resource.data.to;
      allow update: if request.auth != null
        && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
    }
    // Ответы в личке: пишут и читают только два участника сообщения.
    function isMessageMember(messageId, participants) {
      let m = get(/databases/$(database)/documents/messages/$(messageId)).data;
      return request.auth.uid in [m.to, m.from] && participants == [m.to, m.from];
    }
    match /replies/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['messageId', 'participants', 'from', 'name', 'text', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.messageId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time
        && isMessageMember(request.resource.data.messageId, request.resource.data.participants);
    }
    // Счётчики: visits_<день> и dl_<программа>_<день>. Любой может прибавить ровно 1, читают только админы.
    match /stats/{id} {
      allow read: if isAdmin();
      allow create: if id.matches('^(visits|dl_[A-Za-z0-9-]+)_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1;
    }
    // Профиль: имя и аватарка (сжатая картинка строкой). Видит и меняет только владелец.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'photo'])
        && request.resource.data.get('name', '').size() <= 80
        && request.resource.data.get('photo', '').size() <= 100000;
    }
    // Админ = документ admins/<почта>. Список читать нельзя, только проверить себя. Меняется из консоли.
    match /admins/{email} {
      allow get: if isGoogle() && request.auth.token.email == email;
    }
  }
}
